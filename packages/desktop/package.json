{
	"name": "@percho/desktop",
	"version": "0.6.6",
	"private": true,
	"description": "Desktop GUI for the Pi coding agent",
	"author": "Jaxton07",
	"license": "MIT",
	"type": "module",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "node ../../scripts/dev-desktop.mjs",
		"predev": "npm run build:lan-web",
		"build:lan-web": "vite build --config src/lan-web/vite.config.ts",
		"build": "npm run build:lan-web && electron-vite build",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"test": "vitest run",
		"dist": "node ../../scripts/package-release.mjs",
		"dist:beta": "node ../../scripts/package-release.mjs --channel beta",
		"icons": "node ../../scripts/generate-app-icons.mjs",
		"start": "electron-vite preview"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@lexical/extension": "0.52.0",
		"@lexical/history": "0.52.0",
		"@lexical/react": "0.52.0",
		"@lexical/rich-text": "0.52.0",
		"@percho/backend": "*",
		"@percho/shared": "*",
		"electron-updater": "^6.8.9",
		"esbuild": "0.25.12",
		"katex": "^0.16.47",
		"lexical": "0.52.0",
		"markstream-react": "^0.0.55",
		"mermaid": "^11.17.2",
		"monaco-editor": "^0.55.1",
		"qrcode": "^1.5.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"stream-markdown": "^0.0.16",
		"stream-monaco": "^0.0.49",
		"thinking-orbs": "^0.3.1",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.1.1",
		"electron": "43.3.0",
		"electron-builder": "^26.0.0",
		"electron-vite": "^5.0.0",
		"happy-dom": "^21.0.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.0",
		"vite": "^7.0.0",
		"vite-plugin-singlefile": "^2.3.3",
		"vitest": "^3.2.0"
	}
}
