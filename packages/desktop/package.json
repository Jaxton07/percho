{
	"name": "@percho/desktop",
	"version": "0.4.6",
	"private": true,
	"description": "Desktop GUI for the Pi coding agent",
	"author": "Jaxton07",
	"license": "MIT",
	"type": "module",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"predev": "npm run build:lan-web",
		"build:lan-web": "vite build --config src/lan-web/vite.config.ts",
		"build": "npm run build:lan-web && electron-vite build",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"test": "vitest run",
		"dist": "npm run build && electron-builder",
		"start": "electron-vite preview"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@earendil-works/pi-ai": "0.84.0",
		"@earendil-works/pi-coding-agent": "0.84.0",
		"@percho/backend": "*",
		"@percho/shared": "*",
		"electron-updater": "^6.8.9",
		"esbuild": "0.25.12",
		"markstream-react": "^0.0.55",
		"monaco-editor": "^0.55.1",
		"qrcode": "^1.5.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"stream-markdown": "^0.0.16",
		"stream-monaco": "^0.0.49",
		"thinking-orbs": "^0.3.1",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.1.1",
		"electron": "43.3.0",
		"electron-builder": "^26.0.0",
		"electron-vite": "^5.0.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.0",
		"vite": "^7.0.0",
		"vite-plugin-singlefile": "^2.3.3",
		"vitest": "^3.2.0"
	}
}
